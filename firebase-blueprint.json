{
  "entities": {
    "Contract": {
      "title": "Contract",
      "description": "Contract agreements between customers and divisions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "Deal": {
      "title": "Deal",
      "description": "Business deal leads and pipeline requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "value": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Invoice billing and billing references",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber"]
    },
    "User": {
      "title": "User",
      "description": "User login identity and profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Store all contracts"
    },
    "/deals/{dealId}": {
      "schema": "Deal",
      "description": "Store all deals"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Store all invoices"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Store user records"
    }
  }
}
