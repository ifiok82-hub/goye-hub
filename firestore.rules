rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // User collection rules
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().id == userId;
      allow delete: if false;
    }

    // Contracts collection rules
    match /contracts/{contractId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Deals collection rules
    match /deals/{dealId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Invoices collection rules
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
