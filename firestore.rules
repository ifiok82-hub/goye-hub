rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create, update: if isOwner(userId) && incoming().id == userId;
      allow delete: if false;
    }

    // Service Requests collection
    match /service_requests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if false;
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if false; // Server-managed
    }

    // Support tickets
    match /support_tickets/{ticketId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Audit logs (immutable)
    match /audit_logs/{logId} {
      allow read, write: if false; // Server-managed only
    }
  }
}
